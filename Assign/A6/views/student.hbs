<div class="container">
    <h2>Edit Student Details</h2>
    <form method="POST" action="/student/update">
        <fieldset>
            <legend>Personal Information</legend>
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>First Name:</label>
                        <input class="form-control" name="firstName" type="text" value="{{viewData.student.firstName}}" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Last Name:</label>
                        <input class="form-control" name="lastName" type="text" value="{{viewData.student.lastName}}" required />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label>Email:</label>
                        <input class="form-control" name="email" type="email" value="{{viewData.student.email}}" required />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Address (Street):</label>
                        <input class="form-control" name="addressStreet" type="text" value="{{viewData.student.addressStreet}}" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Address (City):</label>
                        <input class="form-control" name="addressCity" type="text" value="{{viewData.student.addressCity}}" required />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Address (Province):</label>
                        <input class="form-control" name="addressProvince" type="text" value="{{viewData.student.addressProvince}}" required />
                    </div>
                </div>
            </div>
        </fieldset>
        <fieldset>
            <legend>Academic Information</legend>
            <div class="row">
                <div class="col-md-4">
                    <label>College Employment:</label><br />
                    <div class="form-check">
                        <input class="form-check-input" name="TA" type="checkbox" id="TA" {{#if viewData.student.TA}} checked {{/if}}>
                        <label class="form-check-label" for="TA">
                            Teaching Assistant
                        </label>
                        <br />
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label>Enrollment Status:</label><br />
                        <label class="checkbox-inline">
                            <input type="radio" name="status" value="Full Time" {{#equal viewData.student.status "Full Time"}} checked {{/equal}} /> Full Time
                        </label>
                        <label class="checkbox-inline">
                            <input type="radio" name="status" value="Part Time" {{#equal viewData.student.status "Part Time"}} checked {{/equal}} /> Part Time
                        </label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="course">Enrolled in Course:</label>
                        {{#if viewData.courses}} 
                            <select class="form-select" name="course" id="course">
                                <option value="">Select Course</option>
                                {{#each viewData.courses}}
                                    <option value="{{courseId}}" {{#if selected}} selected {{/if}}>{{courseCode}}</option>
                                {{/each}}
                            </select>
                        {{else}} 
                            <div>No Courses</div>
                        {{/if}}
                    </div>
                </div>
            </div>
        </fieldset>
        <input type="hidden" name="studentNum" value="{{viewData.student.studentNum}}" />
        <hr />
        <input type="submit" class="btn btn-primary float-right" value="Update Student" />
        <a href="/students" class="btn btn-secondary float-left">Back to Students</a>
    </form>
</div>
