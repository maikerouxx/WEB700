<!-- views/students.hbs -->
<div class="row">
    <main class="col-md-12">
        <h2>Students</h2>
        <a href="/students/add" class="btn btn-success float-end mb-3">Add New Student</a>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Student Num</th>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Address</th>
                        <th>Status</th>
                        <th>Course ID</th>
                        <th></th> <!-- Header for the Remove button column -->
                    </tr>
                </thead>
                <tbody>
                    {{#each students}}
                        <tr>
                            <td>{{this.studentNum}}</td>
                            <td><a href="/student/{{this.studentNum}}">{{this.firstName}} {{this.lastName}}</a></td>
                            <td><a href="mailto:{{this.email}}">{{this.email}}</a></td>
                            <td>{{this.addressStreet}}, {{this.addressCity}}, {{this.addressProvince}}</td>
                            <td>{{this.status}}</td>
                            <td><a href="/students?course={{this.course}}">{{this.course}}</a></td>
                            <td>
                                <form action="/student/delete/{{this.studentNum}}" onsubmit="return confirm('Are you sure you want to delete this student?');">
                                    <button type="submit" class="btn btn-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{#unless students.length}}
            <div class="col-md-12 text-center">
                <strong>{{message}}</strong>
            </div>
        {{/unless}}
    </main>
</div>
