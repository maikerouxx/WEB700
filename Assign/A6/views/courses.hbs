<div class="row">
    <main class="col-md-12">
        <h2>Courses</h2>
        <a href="/courses/add" class="btn btn-success float-end mb-3">Add New Course</a>
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Course ID</th>
                        <th>Course Code</th>
                        <th>Description</th>
                        <th></th> <!-- Header for the Remove button column -->
                    </tr>
                </thead>
                <tbody>
                    {{#each courses}}
                        <tr>
                            <td>{{this.courseId}}</td>
                            <td><a href="/course/{{this.courseId}}">{{this.courseCode}}</a></td>
                            <td>{{this.courseDescription}}</td>
                            <td>
                                <form action="/course/delete/{{this.courseId}}" method="GET" onsubmit="return confirmDelete();">
                                    <button type="submit" class="btn btn-danger">Remove</button>
                                </form>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{#unless courses.length}}
            <div class="col-md-12 text-center">
                <strong>{{message}}</strong>
            </div>
        {{/unless}}
    </main>
</div>

<script>
    function confirmDelete() {
        return confirm('Are you sure you want to delete this course?');
    }
</script>
